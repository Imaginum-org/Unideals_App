# Copy to .env — never commit real values
# Backend (shared with Unideals website, see PROJECT_STRUCTURE.md §1)
EXPO_PUBLIC_API_BASE_URL=https://api.unideals.in
# Staging override for dev: EXPO_PUBLIC_API_BASE_URL=https://unideals-staging.onrender.com

# Google (native + expo-auth-session fallback -> POST /api/auth/google/one-tap|exchange)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Razorpay native (backend POST /api/payments/orders|verify is source of truth)
RAZORPAY_KEY_ID=

# ImageKit client (upload signature comes from GET /api/imagekit/auth)
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=

# Ops
SENTRY_DSN=
EAS_PROJECT_ID=
